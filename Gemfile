# Only needed if you want to preview the site on your own computer.
# GitHub Pages builds the site by itself when you push.
# These are the same Jekyll and plugin versions GitHub Pages runs. The all-in-one
# "github-pages" gem would also work, but it no longer installs on the Ruby 2.6 that ships with macOS.
source "https://rubygems.org"

gem "jekyll", "3.10.0"
gem "kramdown-parser-gfm", "1.1.0"
gem "webrick"

group :jekyll_plugins do
  gem "jekyll-feed", "0.17.0"
  gem "jekyll-seo-tag", "2.8.0"
  gem "jekyll-sitemap", "1.4.0"
end
